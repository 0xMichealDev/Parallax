  "sourceOnlyChanges": [
    {
      "path": "app/terminal-service.ts",
      "status": "M",
      "summary": "Adds strictly verified included-credit grants after the base local allowance, shared inspection/grant coordination, bounded provider selection, atomic request accounting and retained read-only discovery/chart observations. Private capacity diagnostics never expose account figures or credentials in public responses. Provider cooldowns, exact-pool verification and transaction boundaries remain enforced; service and database implementation remain private."
    },
    {
      "path": "scripts/test-market-recovery-worker.mjs",
      "status": "A",
      "summary": "Native Worker and D1 fixtures exercise credit-aware recovery in the actual runtime, shared reservations/inspection coordination, provider isolation, retained observations, expiry and exact-pool rejection. The suite depends on excluded server and database implementation and is not exported."
    },
    {
      "path": "scripts/test-market-recovery.mjs",
      "status": "A",
      "summary": "Native service fixtures exercise verified credit grants, concurrency and revalidation boundaries, provider selection, recovery retention and failure handling. The suite depends on private service implementation and is not exported."
    },
    {
      "path": "scripts/test-terminal-prebond.mjs",
      "status": "M",
      "summary": "Updates native pre-bond discovery fixtures for atomic reservations and actual upstream accounting. The suite depends on private provider and database implementation."
    },
    {
      "path": "scripts/test-terminal.mjs",
      "status": "M",
      "summary": "Updates native terminal-service fixtures for paid-provider request accounting and the bounded public recovery path. The suite depends on excluded service implementation."
    }
  ],
