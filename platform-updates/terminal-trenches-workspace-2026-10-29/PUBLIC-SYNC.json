  "sourceOnlyChanges": [
    {
      "path": "app/terminal-service.ts",
      "status": "M",
      "summary": "Expanded bounded discovery coverage across deeper launch pages and merged graduated candidates while retaining provider evidence, shared caches, quotas and cooldown behavior. Private provider transport and service implementation remain outside the public kit."
    },
    {
      "path": "app/terminal/route.ts",
      "status": "M",
      "summary": "Loads the shared market-workspace and Terminal presentation styles after the existing workspace styles. The native route implementation is excluded."
    },
    {
      "path": "app/trenches/route.ts",
      "status": "M",
      "summary": "Loads the shared market-workspace palette and refreshed Trenches stylesheet with updated asset cache references. The native route implementation is excluded."
    },
    {
      "path": "scripts/test-terminal-prebond.mjs",
      "status": "M",
      "summary": "Native service fixtures cover deeper-page source coverage, bounded enrichment and reuse of shared page caches. The suite depends on private provider and database implementation and is not exported."
    },
    {
      "path": "scripts/test-terminal-upgrade.mjs",
      "status": "M",
      "summary": "Native service fixtures cover candidates beyond the prior graduated cutoff, lifecycle and destination-pool proof, page caches and cooldown behavior. The suite depends on private application internals and is not exported."
    }
